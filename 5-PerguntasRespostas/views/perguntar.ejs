<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guia Perguntas</title>    
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-light bg-primary">
        <a class="navbar-brand" href="/">
            <img src="/img/guia.png">
        </a>
    </nav>
    <div class="container">
        <div class="card" id="formulario-pergunta">
            <div class="card-header">
                <h1>Realizar Pergunta</h1>
            </div>
            <div class="card-body">
                <form>
                    <label for="titulo">Pergunta</label>
                    <input type="text" class="form-control">
                    <br>
                    <label for="titulo">Resposta</label>
                    <textarea class="form-control"></textarea>
                    <br>
                    <button class="btn btn-primary">Fazer!</button>
                </form>
            </div>
        </div>
    </div>
</body>
<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</html>